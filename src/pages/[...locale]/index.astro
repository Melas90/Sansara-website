---
/**
 * Home. The order of blocks follows BRIEF.md §3. Each block owns its copy and
 * its surface; this file only decides the sequence.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/blocks/Hero/Hero.astro';
import SystemDiagram from '../../components/blocks/SystemDiagram/SystemDiagram.astro';
import ServicesGlance from '../../components/blocks/ServicesGlance/ServicesGlance.astro';
import Proof from '../../components/blocks/Proof/Proof.astro';
import Testimonials from '../../components/blocks/Testimonials/Testimonials.astro';
import Statement from '../../components/blocks/Statement/Statement.astro';
import Process from '../../components/blocks/Process/Process.astro';
import Founders from '../../components/blocks/Founders/Founders.astro';
import FAQ from '../../components/blocks/FAQ/FAQ.astro';
import FinalCTA from '../../components/blocks/FinalCTA/FinalCTA.astro';
import type { Locale } from '../../config/site';
import { localeStaticPaths, pageCopy, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const copy = pageCopy('home', locale);
---

<BaseLayout locale={locale} title={t('meta.homeTitle')} description={t('meta.homeDescription')}>
  <Hero locale={locale} />
  <ServicesGlance locale={locale} />
  <SystemDiagram locale={locale} />
  <Proof locale={locale} />
  <Testimonials
    locale={locale}
    title={copy.testimonials.title}
    translatedNote={copy.testimonials.translated}
  />
  <Statement text={copy.statement.text} note={copy.statement.note} />
  <Founders locale={locale} />
  <Process locale={locale} />
  <FAQ locale={locale} page="home" title={copy.faq.title} />
  <FinalCTA locale={locale} title={copy.final.title} text={copy.final.text} />
</BaseLayout>
