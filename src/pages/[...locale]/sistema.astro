---
/**
 * The Sansara Client Loop: the flagship page. Promise, the problem it fixes,
 * the path, what is included, why us, fit, process, how the price works, proof,
 * objections, and the call to action.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/blocks/PageHero/PageHero.astro';
import Pains from '../../components/blocks/Pains/Pains.astro';
import Leaks from '../../components/blocks/Leaks/Leaks.astro';
import SystemDiagram from '../../components/blocks/SystemDiagram/SystemDiagram.astro';
import Stages from '../../components/blocks/Stages/Stages.astro';
import Testimonials from '../../components/blocks/Testimonials/Testimonials.astro';
import Values from '../../components/blocks/Values/Values.astro';
import FitList from '../../components/blocks/FitList/FitList.astro';
import Process from '../../components/blocks/Process/Process.astro';
import PriceModel from '../../components/blocks/PriceModel/PriceModel.astro';
import FAQ from '../../components/blocks/FAQ/FAQ.astro';
import FinalCTA from '../../components/blocks/FinalCTA/FinalCTA.astro';
import type { Locale } from '../../config/site';
import { localeStaticPaths, pageCopy } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = pageCopy('sistema', locale);
const home = pageCopy('home', locale);
---

<BaseLayout locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <PageHero locale={locale} title={copy.hero.title} lead={copy.hero.lead} actions />
  <Pains title={copy.pains.title} items={copy.pains.items} />
  <Leaks {...copy.leaks} />
  <SystemDiagram locale={locale} />
  <Stages {...copy.stages} />
  <Testimonials
    locale={locale}
    title={home.testimonials.title}
    translatedNote={home.testimonials.translated}
  />
  <Values title={copy.why.title} lead={copy.why.lead} values={copy.why.values} />
  <FitList copy={copy.fit} />
  <Process locale={locale} copy={copy.process} />
  <PriceModel
    title={copy.price.title}
    lead={copy.price.lead}
    points={copy.price.points}
    noteTitle={copy.price.adBudgetTitle}
    note={copy.price.adBudget}
  />
  <FAQ locale={locale} page="sistema" title={copy.faqTitle} />
  <FinalCTA locale={locale} title={copy.final.title} text={copy.final.text} />
</BaseLayout>
