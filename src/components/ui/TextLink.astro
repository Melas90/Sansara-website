---
/**
 * TextLink: an inline or standalone text link. Underlined always, so it never
 * relies on colour alone. `standalone` gives it a 44px touch target.
 *
 * Props: href, standalone, track, class, plus any native <a> attribute.
 * External links (http...) get rel="noopener" automatically.
 * Content source: slot.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href: string;
  standalone?: boolean;
  track?: 'Lead' | 'Schedule' | 'ViewContent';
} & HTMLAttributes<'a'>;

const { href, standalone = false, track, class: className, ...rest } = Astro.props;
const external = /^https?:/.test(href);
---

<a
  href={href}
  data-track={track}
  rel={external ? 'noopener' : undefined}
  class:list={[
    'text-fg decoration-accent hover:text-accent ease-brand underline decoration-1 underline-offset-4 transition-colors duration-150',
    standalone && 'min-h-target inline-flex items-center',
    className,
  ]}
  {...rest}
>
  <slot />
</a>
