---
/**
 * Founders: who is behind the agency and the three values. Takes an optional
 * real photograph; without one it renders text only. Never a placeholder image.
 *
 * Drop `founders.jpg` into src/assets/photos/ and it appears here.
 *
 * Props: locale, photo (overrides the dropped file), photoAlt.
 * Content source: i18n/home/<locale>.json -> founders.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../../ui/Section.astro';
import Heading from '../../ui/Heading.astro';
import type { Locale } from '../../../config/site';
import { pageCopy } from '../../../i18n/utils';

interface Props {
  locale: Locale;
  photo?: ImageMetadata;
  photoAlt?: string;
}
const copy = pageCopy('home', Astro.props.locale).founders;

/* A file named founders.* in src/assets/photos/ is picked up by itself. */
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../../assets/photos/founders.{jpg,jpeg,png,webp}',
    {
      eager: true,
    },
  ),
)[0]?.default;
const photo = Astro.props.photo ?? found;
const photoAlt = Astro.props.photoAlt ?? copy.photoAlt;
---

<Section labelledby="founders-title">
  <Fragment slot="heading">
    <Heading id="founders-title">{copy.title}</Heading>
  </Fragment>

  {photo && (
    <Image
      src={photo}
      alt={photoAlt}
      widths={[400, 800, 1200]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      class="mb-10 h-auto w-full"
    />
  )}

  <div class="max-w-measure flex flex-col gap-y-5 text-lg">
    {copy.body.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </div>

  <dl class="border-rule mt-12 grid border-t sm:grid-cols-3">
    {copy.values.map((value) => (
      <div class="border-rule border-b py-5 sm:border-b-0 sm:border-l sm:px-6 sm:first:border-l-0 sm:first:pl-0">
        <dt class="font-display font-book text-fg leading-heading text-xl">{value.title}</dt>
        <dd class="mt-2 text-base">{value.text}</dd>
      </div>
    ))}
  </dl>
</Section>
