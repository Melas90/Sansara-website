---
/**
 * ProductFeature: the agency's one product, the Sansara Client Loop, set apart
 * from the à la carte services by an ember rule and poster-size type. Used on
 * the home page and at the top of the services index.
 *
 * Props: locale, label, title, text, more (link label), level (heading level).
 * Content source: the calling page's copy; target from config/nav.ts (sistema).
 */
import Heading from '../../ui/Heading.astro';
import Button from '../../ui/Button.astro';
import type { Locale } from '../../../config/site';
import { mainNav } from '../../../config/nav';
import { localePath } from '../../../i18n/utils';

interface Props {
  locale: Locale;
  label: string;
  title: string;
  text: string;
  more: string;
  level?: 2 | 3;
}
const { locale, label, title, text, more, level = 3 } = Astro.props;
const route = mainNav.find((item) => item.key === 'sistema');
---

<div class="border-ember border-t-4 pt-8">
  <p class="text-fg-muted text-sm">{label}</p>
  <div class="mt-3 grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
    <Heading level={level} size="title" class="lg:col-span-6">
      {title}
    </Heading>
    <div class="lg:col-span-6 lg:pt-3">
      <p class="text-fg text-lg">{text}</p>
      {route?.live && (
        <Button href={localePath(locale, route.path)} variant="secondary" class="mt-8">
          {more}
        </Button>
      )}
    </div>
  </div>
</div>
