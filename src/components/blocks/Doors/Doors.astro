---
/**
 * Doors: the ladder of offers (we run it all, we do one part, you do it
 * yourself). Rows, not cards. Order and visibility come from config/nav.ts, so
 * Products stays out until its feature flag is on, and a door only becomes a
 * link once its page is live.
 *
 * Props: locale.
 * Content source: i18n/home/<locale>.json -> doors; config/nav.ts + features.ts.
 */
import Section from '../../ui/Section.astro';
import Heading from '../../ui/Heading.astro';
import TextLink from '../../ui/TextLink.astro';
import type { Locale } from '../../../config/site';
import { features } from '../../../config/features';
import { mainNav } from '../../../config/nav';
import { localePath, pageCopy } from '../../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = pageCopy('home', locale).doors;

const doors = mainNav
  .filter((item) => item.key in copy.items && (item.flag ? features[item.flag] : true))
  .map((item) => ({ ...item, ...copy.items[item.key as keyof typeof copy.items] }));
---

<Section labelledby="doors-title">
  <Fragment slot="heading">
    <Heading id="doors-title">{copy.title}</Heading>
    <p class="mt-4">{copy.lead}</p>
  </Fragment>

  <ul class="border-rule border-t">
    {doors.map((door) => (
      <li class="border-rule grid gap-y-3 border-b py-8 md:grid-cols-12 md:gap-x-8">
        <div class="md:col-span-5">
          <Heading level={3} size="sub">
            {door.title}
          </Heading>
          <p class="text-fg-muted mt-1 text-sm">{door.kicker}</p>
        </div>
        <div class="md:col-span-7">
          <p>{door.text}</p>
          {door.live && (
            <TextLink href={localePath(locale, door.path)} standalone class="mt-2">
              {copy.more}
              <span class="sr-only">: {door.title}</span>
            </TextLink>
          )}
        </div>
      </li>
    ))}
  </ul>
</Section>
