---
/**
 * FinalCTA: the closing band on the dark surface with the three ways to start. One of the
 * two places the second material appears (the other is the system diagram).
 *
 * Props: locale, title, text. Copy is passed in so any page can reuse the block.
 * Content source: the calling page's copy; actions from i18n `actions.*`.
 */
import Section from '../../ui/Section.astro';
import Heading from '../../ui/Heading.astro';
import Actions from '../../ui/Actions.astro';
import type { Locale } from '../../../config/site';

interface Props {
  locale: Locale;
  title: string;
  text: string;
}
const { locale, title, text } = Astro.props;
---

<Section surface="deep" labelledby="final-title">
  <div class="max-w-headline">
    <Heading id="final-title" size="title">
      {title}
    </Heading>
    <p class="max-w-measure mt-6 text-lg">{text}</p>
    <Actions locale={locale} long class="mt-10" />
  </div>
</Section>
