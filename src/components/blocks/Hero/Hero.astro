---
/**
 * Hero: the promise at poster size, who the agency is, the three ways to
 * start, and what it builds at a glance (the four pieces of the Loop). The ember disc is the brand's sun
 * (the same one as the favicon) rising out of the top right corner; it is the
 * hero's only graphic, so there is no stock photo and no gradient.
 *
 * Only the headline may overlap the disc: espresso on ember passes AA, body
 * text on ember would not.
 *
 * Props: locale.
 * Content source: i18n/home/<locale>.json -> hero.
 */
import Container from '../../ui/Container.astro';
import Heading from '../../ui/Heading.astro';
import Actions from '../../ui/Actions.astro';
import type { Locale } from '../../../config/site';
import { pageCopy } from '../../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = pageCopy('home', locale).hero;
---

<section aria-labelledby="hero-title" class="surface-linen relative overflow-hidden">
  <div class="sun" aria-hidden="true"></div>

  <Container class="pt-section relative pb-20">
    <Heading level={1} size="display" id="hero-title" class="max-w-headline">
      {copy.title}
    </Heading>

    <div class="mt-14 grid gap-y-16 lg:mt-20 lg:grid-cols-12 lg:gap-x-12">
      <div class="lg:col-span-5">
        <p class="text-fg max-w-measure text-lg">{copy.lead}</p>
        <Actions locale={locale} long class="mt-10" />
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <h2 class="text-fg-muted text-sm">{copy.glanceTitle}</h2>
        <ul class="mt-4">
          {copy.glance.map((line, index) => (
            <li
              style={`--i:${index}`}
              class:list={[
                'pain',
                'border-rule font-display font-book text-fg leading-heading tracking-heading border-t py-5 text-xl',
                index % 2 === 1 && 'sm:pl-16',
              ]}
            >
              {line}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="border-rule text-fg mt-20 grid border-t pt-6 text-sm sm:grid-cols-3 sm:gap-x-12">
      {copy.facts.map((fact) => (
        <li class="py-1">{fact}</li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .sun {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: var(--sm-sun);
    block-size: var(--sm-sun);
    border-radius: 50%;
    background-color: var(--sm-ember);
    transform: translate(32%, -42%);
  }

  /* On load, once: the sun rises and the quotes arrive like messages. */
  @media (prefers-reduced-motion: no-preference) {
    .sun {
      animation: rise var(--sm-duration-rise) var(--sm-ease) both;
    }

    .pain {
      animation: arrive var(--sm-duration-reveal) linear both;
      animation-delay: calc(var(--sm-duration-reveal) + var(--i) * var(--sm-stagger) * 3);
    }
  }

  @keyframes rise {
    from {
      transform: translate(32%, 8%) scale(0.86);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
    }
  }
</style>
