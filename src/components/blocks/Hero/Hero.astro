---
/**
 * Hero: the promise, the three ways to start, and the four things clients say
 * about their own week. Left-aligned; from 1024px the quotes sit beside the
 * headline instead of under it. No image until real photography exists.
 *
 * Props: locale.
 * Content source: i18n/home/<locale>.json -> hero.
 */
import Section from '../../ui/Section.astro';
import Heading from '../../ui/Heading.astro';
import Actions from '../../ui/Actions.astro';
import type { Locale } from '../../../config/site';
import { pageCopy } from '../../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = pageCopy('home', locale).hero;
---

<Section labelledby="hero-title">
  <div class="grid gap-y-14 lg:grid-cols-12 lg:gap-x-12">
    <div class="lg:col-span-7">
      <Heading level={1} size="display" id="hero-title">
        {copy.title}
      </Heading>
      <p class="max-w-measure mt-8 text-lg">{copy.lead}</p>
      <Actions locale={locale} long class="mt-10" />
    </div>

    <div class="lg:col-span-5 lg:pt-4">
      <h2 class="text-fg-muted text-sm">{copy.painsTitle}</h2>
      <ul class="border-rule mt-3 border-t">
        {copy.pains.map((pain) => (
          <li class="border-rule font-display font-book text-fg leading-heading border-b py-4 text-xl">
            <q>{pain}</q>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <ul class="text-fg-muted mt-16 flex flex-col gap-y-2 text-sm sm:flex-row sm:gap-x-0">
    {copy.facts.map((fact) => (
      <li class="border-rule sm:border-l sm:px-6 sm:first:border-l-0 sm:first:pl-0">{fact}</li>
    ))}
  </ul>
</Section>
